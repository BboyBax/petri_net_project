<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="large_pn" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name><text>Large Petri Net (20 places, 20 transitions)</text></name>

    <!-- ===== Places ===== -->
    <!-- initial markings: random 1..5 -->
    <place id="p0"><name><text>p0</text></name><initialMarking><text>2</text></initialMarking></place>
    <place id="p1"><name><text>p1</text></name><initialMarking><text>5</text></initialMarking></place>
    <place id="p2"><name><text>p2</text></name><initialMarking><text>3</text></initialMarking></place>
    <place id="p3"><name><text>p3</text></name><initialMarking><text>1</text></initialMarking></place>
    <place id="p4"><name><text>p4</text></name><initialMarking><text>4</text></initialMarking></place>
    <place id="p5"><name><text>p5</text></name><initialMarking><text>2</text></initialMarking></place>
    <place id="p6"><name><text>p6</text></name><initialMarking><text>5</text></initialMarking></place>
    <place id="p7"><name><text>p7</text></name><initialMarking><text>1</text></initialMarking></place>
    <place id="p8"><name><text>p8</text></name><initialMarking><text>3</text></initialMarking></place>
    <place id="p9"><name><text>p9</text></name><initialMarking><text>4</text></initialMarking></place>
    <place id="p10"><name><text>p10</text></name><initialMarking><text>2</text></initialMarking></place>
    <place id="p11"><name><text>p11</text></name><initialMarking><text>5</text></initialMarking></place>
    <place id="p12"><name><text>p12</text></name><initialMarking><text>1</text></initialMarking></place>
    <place id="p13"><name><text>p13</text></name><initialMarking><text>4</text></initialMarking></place>
    <place id="p14"><name><text>p14</text></name><initialMarking><text>3</text></initialMarking></place>
    <place id="p15"><name><text>p15</text></name><initialMarking><text>5</text></initialMarking></place>
    <place id="p16"><name><text>p16</text></name><initialMarking><text>1</text></initialMarking></place>
    <place id="p17"><name><text>p17</text></name><initialMarking><text>3</text></initialMarking></place>
    <place id="p18"><name><text>p18</text></name><initialMarking><text>4</text></initialMarking></place>
    <place id="p19"><name><text>p19</text></name><initialMarking><text>2</text></initialMarking></place>

    <!-- ===== Transitions ===== -->
    <transition id="t0"><name><text>t0</text></name></transition>
    <transition id="t1"><name><text>t1</text></name></transition>
    <transition id="t2"><name><text>t2</text></name></transition>
    <transition id="t3"><name><text>t3</text></name></transition>
    <transition id="t4"><name><text>t4</text></name></transition>
    <transition id="t5"><name><text>t5</text></name></transition>
    <transition id="t6"><name><text>t6</text></name></transition>
    <transition id="t7"><name><text>t7</text></name></transition>
    <transition id="t8"><name><text>t8</text></name></transition>
    <transition id="t9"><name><text>t9</text></name></transition>
    <transition id="t10"><name><text>t10</text></name></transition>
    <transition id="t11"><name><text>t11</text></name></transition>
    <transition id="t12"><name><text>t12</text></name></transition>
    <transition id="t13"><name><text>t13</text></name></transition>
    <transition id="t14"><name><text>t14</text></name></transition>
    <transition id="t15"><name><text>t15</text></name></transition>
    <transition id="t16"><name><text>t16</text></name></transition>
    <transition id="t17"><name><text>t17</text></name></transition>
    <transition id="t18"><name><text>t18</text></name></transition>
    <transition id="t19"><name><text>t19</text></name></transition>

    <!-- ===== Arcs (random 2-input, 2-output per transition) ===== -->

    <!-- t0 -->
    <arc id="a0" source="p9" target="t0"/>
    <arc id="a1" source="p4" target="t0"/>
    <arc id="a2" source="t0" target="p19"/>
    <arc id="a3" source="t0" target="p3"/>

    <!-- t1 -->
    <arc id="a4" source="p2" target="t1"/>
    <arc id="a5" source="p18" target="t1"/>
    <arc id="a6" source="t1" target="p16"/>
    <arc id="a7" source="t1" target="p1"/>

    <!-- t2 -->
    <arc id="a8" source="p10" target="t2"/>
    <arc id="a9" source="p1" target="t2"/>
    <arc id="a10" source="t2" target="p2"/>
    <arc id="a11" source="t2" target="p4"/>

    <!-- t3 -->
    <arc id="a12" source="p4" target="t3"/>
    <arc id="a13" source="p17" target="t3"/>
    <arc id="a14" source="t3" target="p11"/>
    <arc id="a15" source="t3" target="p3"/>

    <!-- t4 -->
    <arc id="a16" source="p6" target="t4"/>
    <arc id="a17" source="p13" target="t4"/>
    <arc id="a18" source="t4" target="p17"/>
    <arc id="a19" source="t4" target="p0"/>

    <!-- t5 -->
    <arc id="a20" source="p2" target="t5"/>
    <arc id="a21" source="p11" target="t5"/>
    <arc id="a22" source="t5" target="p15"/>
    <arc id="a23" source="t5" target="p16"/>

    <!-- t6 -->
    <arc id="a24" source="p0" target="t6"/>
    <arc id="a25" source="p2" target="t6"/>
    <arc id="a26" source="t6" target="p5"/>
    <arc id="a27" source="t6" target="p8"/>

    <!-- t7 -->
    <arc id="a28" source="p19" target="t7"/>
    <arc id="a29" source="p3" target="t7"/>
    <arc id="a30" source="t7" target="p0"/>
    <arc id="a31" source="t7" target="p1"/>

    <!-- t8 -->
    <arc id="a32" source="p14" target="t8"/>
    <arc id="a33" source="p11" target="t8"/>
    <arc id="a34" source="t8" target="p8"/>
    <arc id="a35" source="t8" target="p12"/>

    <!-- t9 -->
    <arc id="a36" source="p1" target="t9"/>
    <arc id="a37" source="p0" target="t9"/>
    <arc id="a38" source="t9" target="p7"/>
    <arc id="a39" source="t9" target="p10"/>

    <!-- t10 -->
    <arc id="a40" source="p3" target="t10"/>
    <arc id="a41" source="p14" target="t10"/>
    <arc id="a42" source="t10" target="p4"/>
    <arc id="a43" source="t10" target="p2"/>

    <!-- t11 -->
    <arc id="a44" source="p4" target="t11"/>
    <arc id="a45" source="p0" target="t11"/>
    <arc id="a46" source="t11" target="p18"/>
    <arc id="a47" source="t11" target="p7"/>

    <!-- t12 -->
    <arc id="a48" source="p8" target="t12"/>
    <arc id="a49" source="p6" target="t12"/>
    <arc id="a50" source="t12" target="p11"/>
    <arc id="a51" source="t12" target="p5"/>

    <!-- t13 -->
    <arc id="a52" source="p18" target="t13"/>
    <arc id="a53" source="p4" target="t13"/>
    <arc id="a54" source="t13" target="p14"/>
    <arc id="a55" source="t13" target="p17"/>

    <!-- t14 -->
    <arc id="a56" source="p3" target="t14"/>
    <arc id="a57" source="p17" target="t14"/>
    <arc id="a58" source="t14" target="p5"/>
    <arc id="a59" source="t14" target="p8"/>

    <!-- t15 -->
    <arc id="a60" source="p11" target="t15"/>
    <arc id="a61" source="p6" target="t15"/>
    <arc id="a62" source="t15" target="p1"/>
    <arc id="a63" source="t15" target="p10"/>

    <!-- t16 -->
    <arc id="a64" source="p15" target="t16"/>
    <arc id="a65" source="p8" target="t16"/>
    <arc id="a66" source="t16" target="p9"/>
    <arc id="a67" source="t16" target="p19"/>

    <!-- t17 -->
    <arc id="a68" source="p4" target="t17"/>
    <arc id="a69" source="p12" target="t17"/>
    <arc id="a70" source="t17" target="p13"/>
    <arc id="a71" source="t17" target="p7"/>

    <!-- t18 -->
    <arc id="a72" source="p10" target="t18"/>
    <arc id="a73" source="p19" target="t18"/>
    <arc id="a74" source="t18" target="p18"/>
    <arc id="a75" source="t18" target="p6"/>

    <!-- t19 -->
    <arc id="a76" source="p3" target="t19"/>
    <arc id="a77" source="p0" target="t19"/>
    <arc id="a78" source="t19" target="p4"/>
    <arc id="a79" source="t19" target="p2"/>

  </net>
</pnml>
