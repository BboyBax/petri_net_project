<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="net20" type="http://www.pnml.org/version-2009/grammar/ptnet">

    <!-- 20 Places -->
    <place id="p1"><name><text>P1</text></name><initialMarking><text>1</text></initialMarking></place>
    <place id="p2"><name><text>P2</text></name><initialMarking><text>0</text></initialMarking></place>
    <place id="p3"><name><text>P3</text></name><initialMarking><text>0</text></initialMarking></place>
    <place id="p4"><name><text>P4</text></name><initialMarking><text>0</text></initialMarking></place>
    <place id="p5"><name><text>P5</text></name><initialMarking><text>0</text></initialMarking></place>
    <place id="p6"><name><text>P6</text></name><initialMarking><text>0</text></initialMarking></place>
    <place id="p7"><name><text>P7</text></name><initialMarking><text>0</text></initialMarking></place>
    <place id="p8"><name><text>P8</text></name><initialMarking><text>0</text></initialMarking></place>
    <place id="p9"><name><text>P9</text></name><initialMarking><text>0</text></initialMarking></place>
    <place id="p10"><name><text>P10</text></name><initialMarking><text>0</text></initialMarking></place>
    <place id="p11"><name><text>P11</text></name><initialMarking><text>0</text></initialMarking></place>
    <place id="p12"><name><text>P12</text></name><initialMarking><text>0</text></initialMarking></place>
    <place id="p13"><name><text>P13</text></name><initialMarking><text>0</text></initialMarking></place>
    <place id="p14"><name><text>P14</text></name><initialMarking><text>0</text></initialMarking></place>
    <place id="p15"><name><text>P15</text></name><initialMarking><text>0</text></initialMarking></place>
    <place id="p16"><name><text>P16</text></name><initialMarking><text>0</text></initialMarking></place>
    <place id="p17"><name><text>P17</text></name><initialMarking><text>0</text></initialMarking></place>
    <place id="p18"><name><text>P18</text></name><initialMarking><text>0</text></initialMarking></place>
    <place id="p19"><name><text>P19</text></name><initialMarking><text>0</text></initialMarking></place>
    <place id="p20"><name><text>P20</text></name><initialMarking><text>0</text></initialMarking></place>

    <!-- 5 Transitions -->
    <transition id="t1"><name><text>T1</text></name></transition>
    <transition id="t2"><name><text>T2</text></name></transition>
    <transition id="t3"><name><text>T3</text></name></transition>
    <transition id="t4"><name><text>T4</text></name></transition>
    <transition id="t5"><name><text>T5</text></name></transition>

    <!-- Arcs: chuỗi dài qua các place -->
    <!-- P1 -> T1 -> P2 -->
    <arc id="a1" source="p1" target="t1"><inscription><text>1</text></inscription></arc>
    <arc id="a2" source="t1" target="p2"><inscription><text>1</text></inscription></arc>

    <!-- P2 -> T2 -> P3 -->
    <arc id="a3" source="p2" target="t2"><inscription><text>1</text></inscription></arc>
    <arc id="a4" source="t2" target="p3"><inscription><text>1</text></inscription></arc>

    <!-- P3 -> T3 -> P4 -->
    <arc id="a5" source="p3" target="t3"><inscription><text>1</text></inscription></arc>
    <arc id="a6" source="t3" target="p4"><inscription><text>1</text></inscription></arc>

    <!-- P4 -> T4 -> P5 -->
    <arc id="a7" source="p4" target="t4"><inscription><text>1</text></inscription></arc>
    <arc id="a8" source="t4" target="p5"><inscription><text>1</text></inscription></arc>

    <!-- P5 -> T5 -> P6 -->
    <arc id="a9" source="p5" target="t5"><inscription><text>1</text></inscription></arc>
    <arc id="a10" source="t5" target="p6"><inscription><text>1</text></inscription></arc>

    <!-- Chuỗi tiếp tục: P6 -> T1 -> P7, P7 -> T2 -> P8, ... -->
    <!-- Để đơn giản, ta tái sử dụng các transition -->
    <arc id="a11" source="p6" target="t1"><inscription><text>1</text></inscription></arc>
    <arc id="a12" source="t1" target="p7"><inscription><text>1</text></inscription></arc>

    <arc id="a13" source="p7" target="t2"><inscription><text>1</text></inscription></arc>
    <arc id="a14" source="t2" target="p8"><inscription><text>1</text></inscription></arc>

    <arc id="a15" source="p8" target="t3"><inscription><text>1</text></inscription></arc>
    <arc id="a16" source="t3" target="p9"><inscription><text>1</text></inscription></arc>

    <arc id="a17" source="p9" target="t4"><inscription><text>1</text></inscription></arc>
    <arc id="a18" source="t4" target="p10"><inscription><text>1</text></inscription></arc>

    <arc id="a19" source="p10" target="t5"><inscription><text>1</text></inscription></arc>
    <arc id="a20" source="t5" target="p11"><inscription><text>1</text></inscription></arc>

    <!-- Tiếp tục nối đến P20 -->
    <arc id="a21" source="p11" target="t1"><inscription><text>1</text></inscription></arc>
    <arc id="a22" source="t1" target="p12"><inscription><text>1</text></inscription></arc>

    <arc id="a23" source="p12" target="t2"><inscription><text>1</text></inscription></arc>
    <arc id="a24" source="t2" target="p13"><inscription><text>1</text></inscription></arc>

    <arc id="a25" source="p13" target="t3"><inscription><text>1</text></inscription></arc>
    <arc id="a26" source="t3" target="p14"><inscription><text>1</text></inscription></arc>

    <arc id="a27" source="p14" target="t4"><inscription><text>1</text></inscription></arc>
    <arc id="a28" source="t4" target="p15"><inscription><text>1</text></inscription></arc>

    <arc id="a29" source="p15" target="t5"><inscription><text>1</text></inscription></arc>
    <arc id="a30" source="t5" target="p16"><inscription><text>1</text></inscription></arc>

    <arc id="a31" source="p16" target="t5"><inscription><text>1</text></inscription></arc>
   </net>
</pnml>